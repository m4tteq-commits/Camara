# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CAMARA_API_KEY=
CAMARA_PORT=8088
CAMARA_BIND_ADDRESS=127.0.0.1
# Keep the previous key here only while moving devices to a new key.
CAMARA_PREVIOUS_API_KEY=
OLLAMA_MODEL=qwen3.5:2b
# Optional cloud inference. Fill in both the key and model ID for each enabled provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Host directories; backup directory must be writable by container UID 10001.
CAMARA_BACKUPS_DIR=/DATA/AppData/camara/backups
CAMARA_MODELS_DIR=/DATA/AppData/camara/models
